rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'dientinturnero@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Staff = admin o cuenta registrada y aprobada por el admin
    function staff() {
      return isAdmin() || (request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.aprobado == true);
    }

    match /usuarios/{uid} {
      allow read: if isAdmin() || request.auth.uid == uid;
      // cada uno crea su propio perfil, siempre sin aprobar
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.aprobado == false
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if isAdmin();
    }

    match /turnos/{id} {
      allow read, write: if staff();
    }
    match /pacientes/{id} {
      allow read, write: if staff();
    }
  }
}
